# MongoDB connection string
MONGO_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>"

# JSON Web Token secret key for signing auth tokens
JWT_SECRET="your_jwt_secret_key_here"

# ImageKit Private Key for audio file storage uploads
IMAGEKIT_PRIVATE_KEY="private_your_imagekit_private_key_here"

# Google Gemini API key for AI mood extraction and auto-tagging
GEMINI_API_KEY="your_gemini_api_key_here"
