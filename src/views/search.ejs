<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>MoodSwings — Search</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 700px; margin: 40px auto; padding: 0 16px; color: #222; }
    h1 { margin-bottom: 4px; }
    .subtitle { color: #666; margin-top: 0; margin-bottom: 24px; }
    form { margin-bottom: 16px; display: flex; gap: 8px; }
    input[type=text] { flex: 1; padding: 10px; font-size: 14px; border: 1px solid #ccc; border-radius: 6px; }
    button { padding: 10px 18px; font-size: 14px; border: none; border-radius: 6px; background: #333; color: #fff; cursor: pointer; }
    button:hover { background: #000; }
    .divider { text-align: center; color: #aaa; margin: 20px 0; font-size: 13px; }
    .song { border-bottom: 1px solid #eee; padding: 14px 0; }
    .song strong { font-size: 15px; }
    .tag { display: inline-block; background: #f0f0f0; border-radius: 12px; padding: 2px 10px; margin: 4px 6px 0 0; font-size: 12px; color: #555; }
    .meta { margin: 6px 0; }
    audio { width: 100%; margin-top: 6px; }
    .empty { color: #888; font-style: italic; }
  </style>
</head>
<body>
  <h1>MoodSwings</h1>
  <p class="subtitle">Search by name, or just tell it how you feel.</p>

  <form method="GET" action="/search">
    <input type="text" name="q" placeholder="Search by song or artist name" value="<%= q %>">
    <button type="submit">Search</button>
  </form>

  <div class="divider">— or —</div>

  <form method="GET" action="/search">
    <input type="text" name="feeling" placeholder="e.g. I feel heartbroken, need something slow" value="<%= feeling %>">
    <button type="submit">Search by mood</button>
  </form>

  <% if (mode === "mood") { %>
    <p class="meta">
      Matched moods:
      <% if (tagsUsed.length) { %>
        <% tagsUsed.forEach(function(tag) { %><span class="tag"><%= tag %></span><% }) %>
      <% } else { %>
        <span class="empty">no matching mood detected</span>
      <% } %>
    </p>
  <% } %>

  <% if (mode && songs.length === 0) { %>
    <p class="empty">No songs found.</p>
  <% } %>

  <% songs.forEach(function(song) { %>
    <div class="song">
      <strong><%= song.title %></strong> — <%= song.artist ? song.artist.name : "Unknown artist" %>
      <div>
        <% (song.tags || []).forEach(function(tag) { %><span class="tag"><%= tag %></span><% }) %>
      </div>
      <audio controls src="<%= song.url %>"></audio>
    </div>
  <% }) %>
</body>
</html>
